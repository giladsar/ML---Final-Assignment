View(Tinder_filtered)
Booster_rnds_metrics_com <- bind_rows(
"rf" = collect_metrics(rf_test_comp, summarize = FALSE),
"boosting" = collect_metrics(booster_test_comp, summarize = FALSE),
.id = "Model"
) |>
mutate(
Model = factor(Model, levels = c("rf", "boosting"))
)
Booster_rnds_metrics_com |>
group_by(id, .metric) |>
mutate(
best_model = case_match(.metric,
"mae" ~ Model[which.min(.estimate)],
"rsq" ~ Model[which.max(.estimate)])
) |>
ggplot(aes(Model, .estimate, color = Model)) +
facet_wrap(facets = vars(.metric), scales = "free") +
stat_summary(size = 1,
position = position_nudge(0.1),
show.legend = FALSE) +
geom_point() +
geom_line(aes(group = id, color = best_model))
Booster_rnds_metrics_com |>
group_by(id, .metric) |>
mutate(
best_model = case_match(.metric,
"mae" ~ Model[which.min(.estimate)],
"rsq" ~ Model[which.max(.estimate)])
) |>
ggplot(aes(Model, .estimate, color = Model)) +
facet_wrap(facets = vars(.metric), scales = "free") +
stat_summary(size = 1,
position = position_nudge(0.1),
show.legend = FALSE) +
geom_point() +
geom_line(aes(group = id, color = best_model))
ensemble_metrics |>
filter(Model != "rf", .metric == "mae") |>
pivot_wider(names_from = "Model", values_from = ".estimate") |>
mutate(
diff = bagging - boosting
) |>
summarise(
mean_diff = mean(diff),
std_err = sd(diff),
.lower = mean_diff - 2 * std_err,
.upper = mean_diff + 2 * std_err
)
