#Packages loading:
library(tidyverse)
library(tidymodels)
library(finetune) # tuning hyper parameter
library(baguette)
library(randomForest) # for rand forest
library(xgboost) # booster
library(leaps)
library(VIM) # for KNN to deal with na
# preprocessing
realeye <-read.csv("data/july_08/study-eye-tracking_study-bb4e80e4-c1e9-49dc-8438-79b88be60a9a-aoi-metrics-per-participant.csv")
realeye_filter <- realeye |>
#Gettting rid of bad quality instances
filter(participant_quality_grade_item> 2) |>
select(participant_id,starts_with("aoi_name"):last_col())
qualtrics <- read.csv("data/july_08/Didactic-Objectification_July 14, 2025_11.53.csv")
qualtrics_filtered <- qualtrics |>
#the first rows are trouble!
tail(-2) |>
#Eliminating the test trials
filter(as.Date(StartDate) >= as.Date("2025-04-21")) |>
#Excluding trans(Q86) and non-males(Q16) and non-heterosexual(Q87):
filter(Q16 == "1", Q86 == "1", Q87 == "1" )
subjects_exluded <- nrow(qualtrics) - nrow(qualtrics_filtered)
# Subject didn't met the inclusion criterea
# ----------Binding the Data sets
# Since we are using two different services that fetch responses from subjects,Qualtrics for the surveys and RealEye to get the eye tracking data, we'll need to keep it aligned.
# First, I will arrange the data set that each subject would have one row (now in the RealEye data each subject has 3 rows):
realeye_wide <- realeye_filter |>
pivot_wider(
id_cols = participant_id,
names_from = aoi_name,
values_from = starts_with("aoi_"),
names_glue = "{.value}_{aoi_name}"
)
merged_df_wide <-qualtrics_filtered |>
inner_join(realeye_wide, by =  c("realeye.tester.id" = "participant_id"))
# --------- understanding the data
memory_task_items <- paste0("Q", c(46:55, 59:66))
meeting_exp_items <-  c("ME_1","ME_2", "ME_3")
confidance_items<-  c("Q68","Q98")
social_evalu_items_df <- data.frame(
Morality = c("Q73_5","Q73_6"),
Friendliness = c("Q73_1","Q73_2"),
Ability = c("Q73_3","Q73_4"),
Assertiveness= c("Q73_7","Q73_8")
)
liking_items <- c("Q75_1.LK","Q75_2.LK","Q75_3.LK")
similiarity_items <- c("Q75_4...SML","Q75_5..SML")
closeness_items <- c("Q75_6...CLS","Q77_1.CLS")
attractive_items <- c("Q78_1.ATR","Q78_2.ATR","Q78_3.ATR","Q78_4.ATR","Q78_9.ATR")
obj_att_items <- c(paste0("OBJ1_", c(4:6)),
paste0("OBJ2_", c(1:6)),
paste0("OBJ3_", c(1:5)),
paste0("OBJ4_", c(1:4)))
fixation_number_features <- c("aoi_fixation_total_count_Chest",
"aoi_fixation_total_count_Waist_to_Hips",
"aoi_fixation_total_count_Face",
"aoi_fixation_total_count_Chest_wide",
"aoi_fixation_total_count_Waist_to_Hips_Wide",
"aoi_fixation_total_count_Face_wide")
fixation_time_dwell <-c("aoi_fixation_total_time_spent_ms_Chest",
"aoi_fixation_total_time_spent_ms_Waist_to_Hips",
"aoi_fixation_total_time_spent_ms_Face",
"aoi_fixation_total_time_spent_ms_Chest_wide",
"aoi_fixation_total_time_spent_ms_Waist_to_Hips_Wide",
"aoi_fixation_total_time_spent_ms_Face_wide")
demographics <-  data.frame(
Age = c("Q14"),
Religion = c("Q6"),
# Whether or not he is practicing his religion.
Religion_practicing = c("Q7"),
Native_Lang= c("Q105"),
Student= c("Q8"),
#if he is a student what facualty
Major= c("Q9"),
Family_status = c('Q13'),
#What the Study is about
text = c('Q93')
)
#------- Defining our variables:
merged_df_wide_with_DVs <- merged_df_wide |>
#-------------Memory Task-----------------
#changing to numeric values of the Memory Task items
mutate(across(memory_task_items, as.numeric)) |>
# creating a MT score to each subject
mutate(MT_DV = rowSums(across(all_of(memory_task_items)))) |>
#-------------Meeting Expectations-----------------
#changing to numeric values of the ME items survey
mutate(across(meeting_exp_items, as.numeric)) |>
# creating a mean ME score to each subject
mutate(ME_DV = rowSums(across(all_of(meeting_exp_items)))/length(meeting_exp_items))  |>
mutate(across(confidance_items, as.numeric)) |>
# creating a mean Confidence score to each subject
mutate(confidance_DV = rowSums(across(all_of(confidance_items)))/length(confidance_items)) |>
#--------------------Social Evaluation-------------------
mutate(across(social_evalu_items_df$Morality, as.numeric)) |>
mutate(across(social_evalu_items_df$Friendliness, as.numeric)) |>
mutate(across(social_evalu_items_df$Assertiveness, as.numeric)) |>
mutate(across(social_evalu_items_df$Ability, as.numeric)) |>
mutate(morality_DV = rowSums(across(all_of(social_evalu_items_df$Morality)))/2,
friendliness_DV = rowSums(across(all_of(social_evalu_items_df$Friendliness)))/2,
assertiveness_DV = rowSums(across(all_of(social_evalu_items_df$Assertiveness)))/2,
ability_DV = rowSums(across(all_of(social_evalu_items_df$Ability)))/2) |>
#--------------------Liking-------------------
mutate(across(liking_items, as.numeric)) |>
mutate(liking_DV = rowSums(across(all_of(liking_items)))/length(liking_items)) |>
#--------------------Similarity-------------------
mutate(across(similiarity_items, as.numeric)) |>
mutate(similarity_DV = rowSums(across(all_of(similiarity_items)))/length(similiarity_items)) |>
#--------------------Closeness-------------------
mutate(across(closeness_items, as.numeric)) |>
mutate(closenss_DV = rowSums(across(all_of(closeness_items)))/length(closeness_items)) |>
#-------------------Attractiveness--------------------
mutate(across(attractive_items, as.numeric)) |>
mutate(attractive_DV = rowSums(across(all_of(attractive_items)))/length(attractive_items)) |>
#------------------Objectifying Attitudes--------------
mutate(across(obj_att_items, as.numeric)) |>
#reversing the reserved item to unreserved the reverse
mutate(OBJ3_4 = 6 - OBJ3_4 ) |>
mutate(obj_indx_DV = rowSums(across(all_of(obj_att_items)))/length(obj_att_items)) |>
#-----------------Behavioral Objectification - OUR DV ------------------
# For each participant, aligns with the literature of objectification,  our predicted variable would be the time that a participant fixated on the actress chest minus the time spend looking at her face: Chest - Face
#chest - face:
mutate(dwell_chest_minus_face_DV =aoi_fixation_total_time_spent_ms_Chest  - aoi_fixation_total_time_spent_ms_Face)|>
#Wide version :
mutate(dwell_chest_minus_face_wide_DV = aoi_fixation_total_time_spent_ms_Chest_wide - aoi_fixation_total_time_spent_ms_Face_wide) |>
# --------------- FINAL TOUCHUPs ---------------
#such as demographics and text ("What do you think the Study was about?")
mutate(
Age= as.numeric(get(demographics$Age)),
reli = as.numeric(get(demographics$Religion)),
Religion= as.factor(case_when(
reli == 1 ~ "Jewish",
reli == 2 ~ "Muslim",
reli == 3 ~ "Chirstian",
reli == 4 ~ "Other"
)),
reli_p = as.numeric(get(demographics$Religion_practicing)),
Religion_P = as.factor(case_when(
reli_p == 1 ~ "Practicing",
reli_p == 2 ~ "Secular",
reli_p == 3 ~ "Traditional",
reli_p == 4 ~ "Other"
)),
NL = as.numeric(get(demographics$Native_Lang)),
Native_Lang = as.factor(case_when(
NL == 2 ~ "Hebrew",
NL == 3 ~ "Arabic",
NL == 4 ~ "English",
NL == 5 ~ "Other"
)),
Student =  as.factor(ifelse(get(demographics$Student)==1,1,0)),
FS = as.numeric(get(demographics$Student)),
Family_status = as.factor(case_when(
FS == 1 ~ "Single",
FS == 2 ~ "Married",
FS == 3 ~ "Divorce",
FS == 4 ~ "Widow",
FS == 5 ~ "Other"
)),
text = get(demographics$text)
) |>
select(-c(reli,FS,NL,reli_p))
#Finally we can use only our variables of intrest.
finalize_df <- merged_df_wide_with_DVs |>
select(MT_DV:last_col()) |>
select(-dwell_chest_minus_face_wide_DV)  |>
# I'll also use knn k=5 to deal with NAs
kNN(k = 5) |>
select(-ends_with("_imp"))
View(merged_df_wide_with_DVs)
