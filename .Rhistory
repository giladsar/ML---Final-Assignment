missing_words <- setdiff(Tinder_jobtitle_features, rownames(Tinder_jobTitle_WEmodel))
library(stringdist)
# Create data frames for fuzzy join
missing_df <- data.frame(missing = missing_words, stringsAsFactors = FALSE)
embedding_df <- data.frame(known = rownames(Tinder_jobTitle_WEmodel), stringsAsFactors = FALSE)
# Fuzzy match each missing word to closest known word
suggestions <- stringdist_left_join(missing_df, embedding_df,
by = c("missing" = "known"),
method = "jw",  # Jaro-Winkler
max_dist = 0.2, # you can relax this if needed
distance_col = "dist") |>
group_by(missing) |>
slice_min(order_by = dist, n = 1) |>
ungroup()
